<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_tienda_unicah" model="ir.ui.view">
        <field name="name">res.partner.form.tienda.unicah</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="numero_cuenta_unicah"/>
                <field name="convenio_unicah_id"/>
            </xpath>
        </field>
    </record>
</odoo>