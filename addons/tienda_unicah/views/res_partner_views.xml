<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_tienda_unicah" model="ir.ui.view">
        <field name="name">res.partner.form.tienda.unicah</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="UNICAH" name="unicah_tab">
                    <group>
                        <group string="Datos Institucionales">
                            <field name="tipo_unicah"/>
                            <field name="numero_cuenta_unicah" invisible="tipo_unicah != 'estudiante'"/>
                            <field name="carrera_unicah" invisible="tipo_unicah != 'estudiante'"/>
                        </group>
                        <group string="Beneficios Tienda">
                            <field name="convenio_unicah_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>