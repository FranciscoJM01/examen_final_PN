<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_unicah_reserva_list" model="ir.ui.view">
        <field name="name">unicah.reserva.list</field>
        <field name="model">unicah.reserva</field>
        <field name="arch" type="xml">
            <list string="Reservas de Aulas">
                <field name="name"/>
                <field name="aula"/>
                <field name="solicitante_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="duracion_horas"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_unicah_reserva_form" model="ir.ui.view">
        <field name="name">unicah.reserva.form</field>
        <field name="model">unicah.reserva</field>
        <field name="arch" type="xml">
            <form string="Reserva de Aula">
                <header>
                    <button name="action_confirmar" string="Confirmar Reserva" type="object" class="btn-primary" invisible="estado == 'confirmada'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="aula"/>
                            <field name="solicitante_id"/>
                        </group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                            <field name="duracion_horas"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_unicah_reserva" model="ir.actions.act_window">
        <field name="name">Reservas de Aulas</field>
        <field name="res_model">unicah.reserva</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_unicah_laboratorios_root" name="Aulas UNICAH" sequence="25"/>
    <menuitem id="menu_unicah_reserva_sub" name="Reservas" parent="menu_unicah_laboratorios_root" action="action_unicah_reserva" sequence="10"/>
</odoo>